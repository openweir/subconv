      "cipher": "chacha20-ietf-poly1305",
      "tls": true,
      "servername": "jp.example.com",
      "skip-cert-verify": true,
      "network": "ws",
      "ws-opts": {
        "path": "/ray",
        "headers": {
          "Host": "jp.example.com"
        }
      }
    },
    {
      "name": "JP VMess TLS",
      "type": "vmess",
      "server": "jp.example.com",
      "port": 8443,
      "uuid": "7c8c8c0e-0000-4000-8000-000000000001",
      "alterId": 0,
      "cipher": "aes-128-gcm",
      "udp": true,
      "tls": true,
      "servername": "jp.example.com"
    },
    {
      "name": "US VLESS",
      "type": "vless",
      "server": "us.example.com",
      "port": 443,
      "uuid": "7c8c8c0e-0000-4000-8000-000000000002",
      "flow": "xtls-rprx-vision",
