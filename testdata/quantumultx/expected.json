  "proxy-groups": [
    {
      "name": "Proxy",
      "type": "select",
      "proxies": [
        "Auto",
        "HK SS",
        "DIRECT"
      ]
    },
    {
      "name": "Auto",
      "type": "url-test",
      "proxies": [
        "HK SS",
        "JP VMess",
        "US Trojan"
      ],
      "interval": 600,
      "tolerance": 0
    },
    {
      "name": "Fallback",
      "type": "fallback",
      "proxies": [
        "US VLESS",
        "JP VMess"
      ]
    },
    {
      "name": "Balance",
      "type": "load-balance",
      "proxies": [
        "HK SS",
        "US Trojan"
      ],
      "strategy": "round-robin"
    },
    {
      "name": "HK",
      "type": "select",
      "filter": "HK|香港",
      "include-all-proxies": true
    }
  ],
  "rule-providers": {},
  "rules": [
    "DOMAIN,www.google.com,Proxy",
    "DOMAIN-SUFFIX,youtube.com,Proxy",
    "DOMAIN-KEYWORD,netflix,Auto",
    "IP-CIDR,10.0.0.0/8,DIRECT",
    "IP-CIDR6,fd00::/8,DIRECT",
    "GEOIP,cn,DIRECT",
    "MATCH,Proxy"
  ],
  "warnings": [
    {
      "code": "unsupported_provider",
      "detail": "example.com/qx.list: a remote server list in the client's own format"
    },
    {
      "code": "unsupported_rule",
      "detail": "section [rewrite_local]: 1 lines"
    },
    {
      "code": "unsupported_group",
      "detail": "Home: type ssid"
    },
    {
      "code": "unsupported_rule_set",
      "detail": "Ads: a Quantumult X list, which mihomo cannot read"
    },
    {
      "code": "unsupported_rule_set",
      "detail": "Mixed: a list that names a policy per rule"
    },
    {
      "code": "unsupported_rule",
      "detail": "USER-AGENT,Instagram*,proxy: rule type USER-AGENT"
    }
  ]
}
