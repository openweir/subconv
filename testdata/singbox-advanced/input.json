 "endpoints": [
  {
   "type": "wireguard",
   "tag": "WG multi",
   "address": [
    "10.0.0.2/32",
    "fd00::2/128",
    "10.0.0.3/32"
   ],
   "private_key": "PRIV",
   "mtu": 1280,
   "peers": [
    {
     "address": "w1.example.com",
     "port": 51820,
     "public_key": "PUB1",
     "allowed_ips": [
      "10.1.0.0/16"
     ],
     "persistent_keepalive_interval": 25
    },
    {
     "address": "w2.example.com",
     "port": 51821,
     "public_key": "PUB2",
     "pre_shared_key": "PSK",
     "allowed_ips": [
      "0.0.0.0/0"
     ],
     "reserved": [
      1,
      2,
      3
     ]
    }
   ]
  },
  {
   "type": "tailscale",
   "tag": "TS",
   "auth_key": "tskey-auth-example",
   "hostname": "router",
   "accept_routes": true,
   "state_directory": "/var/lib/ts"
  }
 ],
 "route": {
  "rule_set": [
   {
    "tag": "cn",
    "type": "remote",
    "format": "binary",
    "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/cn.srs",
    "download_detour": "Proxy"
   },
   {
    "tag": "cn-ip",
    "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo-lite/geoip/cn.srs"
   },
   {
    "tag": "custom",
    "type": "remote",
    "format": "source",
    "url": "https://example.com/custom.json"
   },
   {
    "tag": "local",
    "type": "local",
    "path": "/etc/sing-box/local.srs"
   }
  ],
  "rules": [
   {
    "rule_set": [
     "cn"
    ],
    "domain_suffix": [
     "example.cn"
    ],
    "outbound": "direct"
   },
   {
    "rule_set": "cn-ip",
    "rule_set_ip_cidr_match_source": true,
    "outbound": "direct"
   },
   {
    "geosite": [
     "category-ads-all"
    ],
    "action": "reject"
   },
   {
    "geoip": "private",
    "outbound": "direct"
   },
   {
    "source_ip_is_private": true,
    "port": [
     53
    ],
    "outbound": "direct"
   },
   {
    "user_id": [
     1000
    ],
    "outbound": "Proxy"
   },
   {
    "rule_set": "custom",
    "outbound": "Proxy"
   },
   {
    "domain": "x.com",
    "outbound": "Missing"
   },
   {
    "type": "logical",
    "mode": "and",
    "rules": [
     {
      "ip_cidr": "1.1.1.1/32"
     },
     {
      "network": "udp"
     }
    ],
    "invert": true,
    "outbound": "Auto"
   }
  ],
  "final": "Gone"
 }
