      "health-check": {
        "enable": true,
        "url": "https://www.gstatic.com/generate_204",
        "interval": "300"
      },
      "filter": "(?i)hk|sg"
    },
    "local": {
      "type": "file",
      "path": "./local.yaml"
    }
  },
  "proxy-groups": [
    {
      "name": "Proxy",
      "type": "select",
      "proxies": [
        "Auto",
        "HK 01",
        "HK 01 2",
        "DIRECT",
        "Chain"
      ],
      "use": [
        "airport",
        "local"
      ]
    },
    {
      "name": "Auto",
      "type": "url-test",
      "proxies": [
        "HK 01",
        "VMess legacy",
        "Loop"
      ],
      "url": "https://cp.cloudflare.com",
      "interval": 300,
      "tolerance": "50"
    },
    {
      "name": "Loop",
      "type": "select",
      "proxies": [
        "Trojan"
      ]
    },
    {
      "name": "Balance",
      "type": "load-balance",
      "strategy": "round-robin",
      "proxies": [
        "HK 01",
        "Hy2 hop"
      ]
    },
    {
      "name": "All",
      "type": "select",
      "include-all": true,
      "filter": "(?\u003c=HK)"
    }
  ],
  "rule-providers": {
    "reject": {
      "type": "http",
      "behavior": "domain",
      "url": "https://example.com/reject.txt",
      "interval": 86400
    },
    "cn": {
      "type": "http",
      "behavior": "ipcidr",
      "url": "https://example.com/cn.mrs",
      "format": "mrs"
    },
    "geosite-cn": {
      "type": "http",
      "behavior": "domain",
      "format": "mrs",
      "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/cn.mrs"
    },
    "local": {
      "type": "file",
      "behavior": "domain",
      "path": "./local.yaml"
    },
    "lan": {
      "type": "inline",
      "behavior": "classical",
      "payload": [
        "DOMAIN-SUFFIX,lan",
        "IP-CIDR,192.168.0.0/16,no-resolve"
      ]
    }
  },
  "rules": [
    "RULE-SET,reject,REJECT",
    "RULE-SET,cn,DIRECT,no-resolve",
    "RULE-SET,geosite-cn,DIRECT",
    "RULE-SET,local,DIRECT",
    "RULE-SET,lan,DIRECT",
    "DOMAIN-SUFFIX,google.com,Proxy",
    "IP-CIDR,8.8.8.8/32,Proxy,no-resolve",
    "DST-PORT,6000-6100,Chain",
    "AND,((NETWORK,UDP),(DST-PORT,443)),REJECT",
    "OR,((DOMAIN,a.com),(RULE-SET,local)),Proxy",
    "DOMAIN,d.com,Proxy",
    "MATCH,Proxy"
  ],
